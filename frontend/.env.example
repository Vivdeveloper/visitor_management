# Frappe site URL for `npm run dev` proxy (overrides common_site_config webserver_port)
VITE_FRAPPE_URL=http://127.0.0.1:8023

# MSG91 OTP Widget — BROWSER-SAFE (Widget Token, not the full AuthKey)
# Get from: MSG91 Dashboard → OTP Widget/SDK → Widgets → [widget] → Client Side Integration
# VITE_MSG91_WIDGET_ID=your_widget_id_here
# VITE_MSG91_WIDGET_TOKEN=your_widget_token_here
