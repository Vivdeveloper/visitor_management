# Capacitor native shell — copy to `.env.capacitor` and set your Frappe site URL.
# Required when API calls leave the bundled WebView (session cookies + CSRF).

VITE_CAPACITOR=true
VITE_API_BASE=https://your-frappe-site.example.com

# Optional: load the WebView from your bench URL instead of bundled dist/
# CAPACITOR_SERVER_URL=https://your-frappe-site.example.com/vms/

# Lock-screen / background push (FCM). Requires google-services.json in android/app/
# VITE_NATIVE_PUSH=true
